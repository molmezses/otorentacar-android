<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_5xl"
            android:clipChildren="false"
            android:clipToPadding="false">

        <include
            android:id="@+id/topBar"
            layout="@layout/layout_top_bar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_3xl"
            android:fontFamily="@font/inter_bold"
            android:text="@string/home_title_line_1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_4xl"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="@string/home_title_line_2"
            android:textColor="@color/primary_green_dark"
            android:textSize="@dimen/text_4xl"
            android:textStyle="bold" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/searchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_app_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="@string/pickup_location"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_location_card_height"
                android:layout_marginTop="@dimen/spacing_10dp"
                app:cardBackgroundColor="@color/bg_input"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_lg">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_near_me"
                        android:tint="@color/primary_green_dark"
                        tools:ignore="UseAppTint" />

                    <AutoCompleteTextView
                        android:id="@+id/actPickupLocation"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/radius_14dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:completionThreshold="1"
                        android:dropDownAnchor="@id/actPickupLocation"
                        android:dropDownHeight="wrap_content"
                        android:dropDownVerticalOffset="@dimen/spacing_sm"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_medium"
                        android:hint="@string/location_hint"
                        android:inputType="none"
                        android:maxLines="2"
                        android:paddingVertical="0dp"
                        android:scrollHorizontally="false"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="@dimen/text_md" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md">

                <TextView
                    android:id="@+id/tvDropInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_medium"
                    android:maxLines="2"
                    android:text="@string/different_dropoff"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_md"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/switchDrop"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Switch
                    android:id="@+id/switchDrop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/switch_thumb_selector"
                    android:trackTint="@color/switch_track_selector"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/layoutDropOffSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_10dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/dropoff_location"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_location_card_height"
                    android:layout_marginTop="@dimen/spacing_10dp"
                    app:cardBackgroundColor="@color/bg_input"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_lg">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:src="@drawable/ic_near_me"
                            android:tint="@color/primary_green_dark"
                            tools:ignore="UseAppTint" />

                        <AutoCompleteTextView
                            android:id="@+id/actDropOffLocation"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/radius_14dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:completionThreshold="1"
                            android:dropDownAnchor="@id/actDropOffLocation"
                            android:dropDownHeight="wrap_content"
                            android:dropDownVerticalOffset="@dimen/spacing_sm"
                            android:ellipsize="end"
                            android:fontFamily="@font/inter_medium"
                            android:hint="@string/dropoff_location_hint"
                            android:inputType="none"
                            android:maxLines="2"
                            android:paddingVertical="0dp"
                            android:scrollHorizontally="false"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:textSize="@dimen/text_md" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="@string/pickup_date"
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/text_sm" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/home_date_time_card_height"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:cardBackgroundColor="@color/bg_input"
                        app:cardCornerRadius="@dimen/radius_lg"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingStart="@dimen/radius_14dp"
                            android:paddingTop="@dimen/spacing_5dp"
                            android:paddingEnd="@dimen/radius_14dp"
                            android:paddingBottom="@dimen/spacing_5dp">

                            <TextView
                                android:id="@+id/tvPickupDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:lineSpacingExtra="@dimen/spacing_3xs"
                                android:text="@string/pickup_date_card_placeholder"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_md"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/ivPickupDate"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/ivPickupDate"
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:src="@drawable/ic_calendar"
                                android:tint="@color/primary_green_dark"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:ignore="UseAppTint" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <Space
                    android:layout_width="@dimen/radius_14dp"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="@string/pickup_time"
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/text_sm" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/home_date_time_card_height"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:cardBackgroundColor="@color/bg_input"
                        app:cardCornerRadius="@dimen/radius_lg"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingStart="@dimen/radius_14dp"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingEnd="@dimen/radius_14dp"
                            android:paddingBottom="@dimen/spacing_md">

                            <TextView
                                android:id="@+id/tvPickupTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="10:00"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_md"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/ivPickupTime"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/ivPickupTime"
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:src="@drawable/ic_time"
                                android:tint="@color/primary_green_dark"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:ignore="UseAppTint" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="@string/dropoff_date"
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/text_sm" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/home_date_time_card_height"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:cardBackgroundColor="@color/bg_input"
                        app:cardCornerRadius="@dimen/radius_lg"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingStart="@dimen/radius_14dp"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingEnd="@dimen/radius_14dp"
                            android:paddingBottom="@dimen/spacing_md">

                            <TextView
                                android:id="@+id/tvDropOffDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:lineSpacingExtra="@dimen/spacing_3xs"
                                android:text="@string/dropoff_date_card_placeholder"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_md"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/ivDropOffDate"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/ivDropOffDate"
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:src="@drawable/ic_calendar"
                                android:tint="@color/primary_green_dark"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:ignore="UseAppTint" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <Space
                    android:layout_width="@dimen/radius_14dp"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="@string/dropoff_time"
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/text_sm" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/home_date_time_card_height"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:cardBackgroundColor="@color/bg_input"
                        app:cardCornerRadius="@dimen/radius_lg"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingStart="@dimen/radius_14dp"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingEnd="@dimen/radius_14dp"
                            android:paddingBottom="@dimen/spacing_md">

                            <TextView
                                android:id="@+id/tvDropOffTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="10:00"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_md"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/ivDropOffTime"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/ivDropOffTime"
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:src="@drawable/ic_time"
                                android:tint="@color/primary_green_dark"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:ignore="UseAppTint" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvDateValidationError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/inter_bold"
                android:text="@string/date_validation_error"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="@dimen/text_sm"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFindCar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_70dp"
                android:layout_marginTop="@dimen/spacing_18dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/find_car"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_green_dark"
                app:cornerRadius="@dimen/radius_lg" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/campaignSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp">

            <ImageView
                android:id="@+id/ivCampaignBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_campaign_top_offset"
                android:adjustViewBounds="true"
                android:contentDescription="@string/campaign_banner_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/promo_home"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWhatsApp"
        android:layout_width="@dimen/whatsapp_button_size"
        android:layout_height="@dimen/whatsapp_button_size"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/home_whatsapp_fixed_end"
        android:layout_marginBottom="@dimen/home_whatsapp_fixed_end"
        android:clickable="true"
        android:contentDescription="@string/content_desc_whatsapp"
        android:focusable="true"
        app:cardBackgroundColor="#25D366"
        app:cardCornerRadius="@dimen/whatsapp_button_radius"
        app:cardElevation="@dimen/spacing_3xs"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="@dimen/icon_xl"
            android:layout_height="@dimen/icon_xl"
            android:layout_gravity="center"
            android:src="@drawable/whatsapp"
            android:tint="@color/white"
            tools:ignore="UseAppTint" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
