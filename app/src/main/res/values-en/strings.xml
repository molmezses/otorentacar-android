    <string name="about_subtitle">Basic information about Otorentacar</string>
    <string name="about_company_text">Otorentacar is a growing brand that has made significant investments in the car rental sector in a short time with the motto “a brand-new car rental experience.” With an expanding service network, it aims to become one of the leading companies in the sector.</string>
    <string name="mission">Our Mission</string>
    <string name="about_mission_text">To make a difference in daily car rental by building a customer-satisfaction-focused system with our high quality standards, customer-oriented approach, and experienced expert team.</string>
    <string name="vision">Our Vision</string>
    <string name="about_vision_text">To create happy and loyal customers by combining high quality standards with fair prices, and to continue operating in daily car and fleet rental with an innovative, customer-focused service model and experienced team.</string>
    <string name="principles">Our Principles</string>
    <string name="about_principle_1">To conduct our work and operations in accordance with the laws and rules of the country where we operate.</string>
    <string name="about_principle_2">To increase customer satisfaction by using resources efficiently and improving service performance and quality.</string>
    <string name="about_principle_3">To build mutually beneficial relationships with customers and make continuous customer satisfaction sustainable.</string>
    <string name="about_principle_4">To ensure the security of personal information belonging to customers, business partners, and employees.</string>
    <string name="about_principle_5">To eliminate conditions that threaten environmental health and workplace safety.</string>
    <string name="about_principle_6">To value institutional development.</string>
    <string name="about_principle_7">To protect our corporate identity against misuse that may cause harm.</string>
    <string name="about_principle_8">To provide equal opportunities for our employees.</string>
    <string name="about_principle_9">To uphold honesty in all our activities.</string>
    <string name="about_principle_10">To make and implement decisions quickly.</string>
    <string name="about_principle_11">To protect the rights of customers, business partners, and employees</string>
    <string name="services_subtitle">Advantages we offer with Otorentacar</string>
    <string name="services_intro_title">We offer affordable car rental options for you.</string>
    <string name="services_intro_desc">Find affordable car rental options with Otorentacar and get on the road. Search our fleet, compare prices instantly, then book your selected vehicle directly.</string>
    <string name="services_support_title">24/7 Car Rental Support Line</string>
    <string name="services_support_desc">Our roadside assistance team is available 24/7. You can contact Otorentacar support for emergencies, unexpected accidents, or situations during your rental.</string>
    <string name="services_delivery_title">Free Delivery Option</string>
    <string name="services_delivery_desc">With one phone call, we bring your vehicle to wherever you are without charging an additional fee.</string>
    <string name="services_clean_title">Clean and Well-Maintained Vehicles</string>
    <string name="services_clean_desc">To help our customers avoid problems, we wash every vehicle and thoroughly check maintenance before delivery.</string>
    <string name="services_luxury_title">Luxury and Comfortable Vehicles</string>
    <string name="services_luxury_desc">With experienced staff and safe vehicles, the comfort and privilege you expect are provided with the same care for your luxury vehicle needs.</string>
    <string name="services_options_title">Different Car Options</string>
    <string name="services_options_desc">We offer quality vehicles that fit your budget. Luxury, family, sedan, and economy options make choosing a car easier.</string>
    <string name="contact_subtitle">The easiest way to reach us</string>
    <string name="contact_desc">You can quickly contact us by phone, email, or WhatsApp.</string>
